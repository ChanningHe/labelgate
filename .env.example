# Labelgate Environment Variables (v0.3)
# Copy this file to .env and fill in your values.
# All variables use the LABELGATE_ prefix for direct pass-through.
# Never commit your real .env file.

# ============================================
# Cloudflare Credentials (Required for main mode)
# ============================================

# API Token (recommended) - create at https://dash.cloudflare.com/profile/api-tokens
#
# MINIMUM REQUIRED PERMISSIONS:
#
# For DNS-only mode:
#   - Zone > Zone > Read          (to lookup zone IDs)
#   - Zone > DNS > Edit           (to create/update/delete DNS records)
#
# For Tunnel mode (includes DNS):
#   - Zone > Zone > Read          (to lookup zone IDs)
#   - Zone > DNS > Edit           (to create/update/delete DNS records)
#   - Account > Cloudflare Tunnel > Edit  (to manage tunnel ingress rules)
#
# For Access policies:
#   - Account > Access: Apps and Policies > Edit
#
# ZONE RESOURCES:
#   - Select "All zones" for managing multiple domains
#   - Or select specific zones if you only manage certain domains
#
# ACCOUNT RESOURCES (for Tunnel / Access):
#   - Select your account that owns the tunnel
#
LABELGATE_CLOUDFLARE_API_TOKEN=

# Account ID - find at https://dash.cloudflare.com (sidebar -> Account ID)
LABELGATE_CLOUDFLARE_ACCOUNT_ID=

# Tunnel ID - create tunnel first: cloudflared tunnel create <name>
# (requires LABELGATE_CLOUDFLARE_ACCOUNT_ID)
LABELGATE_CLOUDFLARE_TUNNEL_ID=

# ============================================
# API & Dashboard (REQUIRED to use them)
# ============================================

# Bearer token for the HTTP API and the dashboard.
# If this is empty, the API and the dashboard are DISABLED (the reconciler keeps running).
# Generate one with: openssl rand -hex 32
LABELGATE_API_TOKEN=

# ============================================
# Lifecycle (defaults shown)
# ============================================

# Interval of the periodic full reconcile (>= 10s)
# LABELGATE_SYNC_INTERVAL=5m

# Orphaned resources with cleanup=true (the default) are deleted after this delay
# LABELGATE_SYNC_REMOVE_DELAY=30m

# How long an offline agent's resources are kept before they are treated as orphaned
# LABELGATE_SYNC_AGENT_GRACE=24h

# ============================================
# Agent Mode Settings (for remote hosts)
# ============================================

# Run as an agent instead of the main instance
# LABELGATE_MODE=agent

# Main Labelgate endpoint. The /ws path is required; use wss:// outside trusted networks.
# LABELGATE_CONNECT_ENDPOINT=wss://labelgate-main.example.com:8081/ws

# Agent authentication token (must match the token configured for this agent on the main instance).
# Use a long random value, one per agent.
# LABELGATE_CONNECT_TOKEN=

# Optional: Agent ID, ^[a-z0-9][a-z0-9_-]{0,62}$
# (default: first 12 hex chars of /etc/machine-id, else the sanitized hostname)
# LABELGATE_CONNECT_AGENT_ID=

# The tunnel an agent may use is decided on the main instance (agent.agents.<id>.default_tunnel / tunnels).

# Heartbeat interval (>= 1s)
# LABELGATE_CONNECT_HEARTBEAT_INTERVAL=30s

# TLS: peers are verified by default. Point to a private CA if needed.
# LABELGATE_CONNECT_TLS_CA=/path/to/ca.pem
# Only for testing; disables certificate verification and logs a warning:
# LABELGATE_CONNECT_TLS_INSECURE_SKIP_VERIFY=false

# ============================================
# Optional Settings
# ============================================

# Log level: debug, info, warn, error
LABELGATE_LOG_LEVEL=info

# Log format: json, text
LABELGATE_LOG_FORMAT=text

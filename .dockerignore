# Keep host build output, dependencies and local secrets out of
# docker/Dockerfile's build context. The image installs its own node_modules
# (Alpine/musl) and builds the dashboard itself.
.git
.github/
bin/
dev/

# local secrets
.env
*.env
!.env.example

# coverage
coverage.out
coverage.html
*.coverprofile

# dependencies and build output
dashboard/node_modules/
dashboard/static/
dashboard/.vite/
docsite/

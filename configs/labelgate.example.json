{
  "label_prefix": "labelgate",
  "log_level": "info",
  "log_format": "text",
  "mode": "main",

  "docker": {
    "endpoint": "unix:///var/run/docker.sock",
    "poll_interval": "2m"
  },

  "cloudflare": {
    "api_token": "your-api-token-here",
    "account_id": "your-account-id",
    "tunnel_id": "your-tunnel-id"
  },

  "sync": {
    "interval": "5m",
    "remove_delay": "30m",
    "orphan_ttl": "0s",
    "agent_grace": "24h"
  },

  "retry": {
    "attempts": 3,
    "delay": "1s",
    "max_delay": "30s",
    "backoff": 2
  },

  "db": {
    "path": "/app/config/labelgate.db"
  },

  "api": {
    "enabled": true,
    "address": ":28111",
    "base_path": "/api",
    "token": "change-me-to-a-long-random-string"
  },

  "agent": {
    "enabled": false,
    "listen": ":28112",
    "accept_services": []
  }
}

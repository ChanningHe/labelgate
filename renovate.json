{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Distroless base images pinned by digest in workflow env (BASE_NONROOT, BASE_DEBUG) and in Dockerfile ARGs/comments",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^docker/[^/]*Dockerfile$/"],
      "matchStrings": [
        "(?<depName>gcr\\.io/distroless/[a-z0-9-]+):(?<currentValue>[a-z0-9.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Go tools run via go run with a version pinned in workflow env or the justfile (# renovate: datasource=... depName=...)",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/^justfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n[a-z_]+_version := \"(?<currentValue>v[0-9][0-9A-Za-z.+-]*)\"",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+_VERSION: (?<currentValue>v[0-9][0-9A-Za-z.+-]*)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Wait before proposing npm releases to skip yanked or compromised versions",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Mantine packages must share one version; @mantine/spotlight is pinned to match @mantine/core",
      "matchFileNames": ["dashboard/**"],
      "matchPackageNames": ["/^@mantine\\//"],
      "groupName": "Mantine"
    },
    {
      "matchFileNames": ["dashboard/**"],
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "matchFileNames": ["dashboard/**"],
      "matchPackageNames": ["vite", "vitest", "/^@vitejs\\//"],
      "groupName": "Vite and Vitest"
    },
    {
      "matchFileNames": ["dashboard/**"],
      "matchPackageNames": ["eslint", "globals", "typescript", "typescript-eslint", "/^@eslint\\//", "/^eslint-plugin-/"],
      "groupName": "Lint and TypeScript"
    },
    {
      "description": "typescript-eslint does not support TypeScript 7 yet (lint fails with 'does not support TS 7.0'); remove this rule once typescript-eslint declares TS 7 support in its typescript peer range",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchFileNames": ["dashboard/**"],
      "matchPackageNames": ["/^@fontsource(-variable)?\\//"],
      "groupName": "Fonts"
    },
    {
      "description": "The docs site is low risk; batch its non-major updates into one PR",
      "matchFileNames": ["docsite/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "docsite dependencies"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go modules"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Base images in Dockerfiles and workflow env",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Container images"
    }
  ]
}
